<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Αλλαγή Παίκτη"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ομάδα"
        android:textSize="12sp"
        android:textColor="#888" />

    <Spinner
        android:id="@+id/spinnerTeam"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Βγαίνει"
        android:textSize="12sp"
        android:textColor="#888" />

    <Spinner
        android:id="@+id/spinnerPlayerOut"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Μπαίνει"
        android:textSize="12sp"
        android:textColor="#888" />

    <Spinner
        android:id="@+id/spinnerPlayerIn"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp" />

    <!-- Λεπτό αγώνα — γεμίζει αυτόματα από MatchClock, μόνο για ενημέρωση. -->
    <TextView
        android:id="@+id/tvCurrentMinute"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingVertical="4dp"
        android:textSize="14sp"
        android:textColor="#888" />

</LinearLayout>
